function Clone()
	local cm = Instance.new("Model")cm.Name = "Clone"
	for i,v in pairs(c:children()) do
		if v.ClassName == "Part" and v.Name ~= "HumanoidRootPart" then
			local cl = v:clone()cl.Anchored = true cl.CanCollide = false cl.Parent = cm cl.Reflectance = 0
			cl.BrickColor = BrickColor.new("Bright red") cl.Transparency = 0.5 cl.TopSurface = "Smooth" cl.BottomSurface = "Smooth"
			if cl:findFirstChild("face")~= nil then
				cl.face:remove()
			end
		end
		if v.ClassName == "Accessory" then
			local cl = v.Handle:clone()cl.Anchored = true cl.CanCollide = false cl.Parent = cm cl.Mesh.TextureId = ""
			cl.BrickColor = BrickColor.new("Bright red")cl.Transparency = 0.75 cl.TopSurface = "Smooth" cl.BottomSurface = "Smooth"
		end
	end
	cm.Parent = m cm:BreakJoints() local S = Instance.new("Sound",cm.Torso)S.SoundId = "rbxassetid://528781006" S.Volume = 0.25 S:Play() game.Debris:AddItem(S,2)
end


function CloneExplode()
	local exploded = false
	if Ragez == false then
		for i,v in pairs(m:children()) do
