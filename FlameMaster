function ShowDamage(damage,pos)
	D = 0
	local P = Instance.new("Part",game.Workspace)P.Transparency = 1 P.Size = Vector3.new(0.2,0.2,0.2) P.CanCollide = false P.CFrame = CFrame.new(pos)
	local bb = Instance.new("BillboardGui",P)bb.Size = UDim2.new(10,0,10,0)
	local s = math.floor(damage*274)
	for i in string.gmatch(s, "%d") do 
		Font(i,bb)
	end
	Spawn(function()
		local BV = Instance.new("BodyVelocity",P)BV.maxForce = Vector3.new(math.huge,math.huge,math.huge)
		BV.Velocity = Vector3.new(math.random(-5,5),10,math.random(-5,5))
		wait(0.5)
		for i = 1,10 do
			local G = bb:GetChildren()
			for i = 1,#G do
				if G[i].ClassName == "ImageLabel" then
					G[i].ImageTransparency = G[i].ImageTransparency + 0.1
				end
			end
			wait()
		end
	end)
end

